OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_TREND_MODEL=gpt-5-mini
OPENAI_TREND_GROUPING_MODEL=gpt-4.1-mini
OPENAI_TREND_MERGE_ENABLED=0
OPENAI_TREND_GROUPING_ENABLED=true
OPENAI_TREND_GROUPING_ROOT_LIMIT=8
OPENAI_TREND_GROUPING_BATCH_SIZE=2
OPENAI_TREND_GROUPING_TIMEOUT_MS=15000
OPENAI_TREND_GROUPING_MAX_TOTAL_MS=25000
REDDIT_ENABLED=1
BLUESKY_ENABLED=1
BLUESKY_FIREHOSE_ENABLED=1
BLUESKY_FIREHOSE_ENDPOINT=wss://jetstream2.us-west.bsky.network/subscribe
BLUESKY_RAW_PERSIST_ENABLED=1
BLUESKY_RAW_EVENT_STORE_PATH=data/reddit_engine/bluesky_jetstream_raw.sqlite3
BLUESKY_RAW_PERSIST_BATCH_SIZE=250
BLUESKY_DASHBOARD_REFRESH_MIN_INTERVAL_SECONDS=20
BLUESKY_FIREHOSE_BOOTSTRAP_HOURS=1
BLUESKY_FIREHOSE_BOOTSTRAP_MINUTES=15
BLUESKY_FIREHOSE_MAX_EVENTS_PER_RUN=40000
BLUESKY_FIREHOSE_MAX_SECONDS_PER_RUN=35
BLUESKY_FIREHOSE_IDLE_TIMEOUT_SECONDS=4
BLUESKY_FIREHOSE_CURSOR_REWIND_SECONDS=5
BLUESKY_FIREHOSE_RETENTION_HOURS=168
BLUESKY_FIREHOSE_COLLECTIONS=app.bsky.feed.post,app.bsky.feed.like,app.bsky.feed.repost,app.bsky.actor.profile,app.bsky.graph.follow
# Set BLUESKY_FIREHOSE_COLLECTIONS=* to consume the full unfiltered Jetstream stream.
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres
USE_SUPABASE_TRENDS=false
SUPABASE_TRENDS_FALLBACK_TO_LEGACY=true
NEXT_PUBLIC_TRENDS_REFRESH_MS=5000
NEXT_PUBLIC_TRENDS_LEGACY_REFRESH_MS=20000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY
BLUESKY_WORKER_SOURCE=bluesky_firehose_worker
BLUESKY_DB_BATCH_SIZE=200
BLUESKY_WORKER_FIREHOSE_MAX_SECONDS_PER_CYCLE=8
BLUESKY_WORKER_FIREHOSE_MAX_EVENTS_PER_CYCLE=12000
BLUESKY_WORKER_LOOP_SLEEP_SECONDS=2
BLUESKY_WORKER_RETRY_SECONDS=5
BLUESKY_TOPIC_AGGREGATE_INTERVAL_SECONDS=20
BLUESKY_WORKER_PROGRESS_UPDATE_SECONDS=15
BLUESKY_WORKER_LOG_LEVEL=INFO
BLUESKY_TREND_ENRICHMENT_ENABLED=true
BLUESKY_TREND_ENRICHMENT_INTERVAL_SECONDS=300
BLUESKY_TREND_ENRICHMENT_MODEL=gpt-5.4-mini
BLUESKY_TREND_ENRICHMENT_PROMPT_VERSION=v1
BLUESKY_TREND_ENRICHMENT_MAX_TOPICS=250
BLUESKY_TREND_ENRICHMENT_POSTS_PER_TOPIC=10
BLUESKY_TREND_ENRICHMENT_CANDIDATE_POST_LIMIT=120
BLUESKY_TREND_ENRICHMENT_STALE_HOURS=6
BLUESKY_TREND_ENRICHMENT_TIMEOUT_SECONDS=30
BLUESKY_TREND_ENRICHMENT_MAX_RETRIES=3
BLUESKY_TREND_ENRICHMENT_RETRY_BACKOFF_SECONDS=1.2
BLUESKY_TREND_ENRICHMENT_MAX_POST_CHARS=260
BLUESKY_TREND_ENRICHMENT_MIN_TEXT_CHARS=28
BLUESKY_TREND_ENRICHMENT_MIN_WORDS=5
YOUTUBE_API_KEY=REPLACE_WITH_YOUTUBE_API_KEY
YOUTUBE_CHANNEL_UPLOADS_PER_CHANNEL=3
YOUTUBE_CHANNEL_LOOKBACK_HOURS=72
YOUTUBE_CHANNEL_MIN_SUBSCRIBERS=250000
YOUTUBE_REFRESH_MINUTES=60
YOUTUBE_DISCOVERY_QUERIES=ai agents,openai,nvidia earnings,bitcoin,ethereum,solana memecoin,fed rates,inflation,tariffs,shipping crisis,middle east,ukraine,election,tiktok,gaming update
YOUTUBE_MAX_KEYWORD_QUERIES_PER_RUN=4
YOUTUBE_MAX_BREAKOUT_QUERIES_PER_RUN=4
YOUTUBE_SEARCH_RESULTS_PER_QUERY=8
YOUTUBE_MAX_RELATED_SEEDS_PER_RUN=6
YOUTUBE_MAX_RELATED_RESULTS_PER_SEED=4
YOUTUBE_MAX_CHANNEL_EXPANSIONS_PER_RUN=12
YOUTUBE_MAX_TRACKED_VIDEOS_PER_RUN=120
YOUTUBE_MAX_COMMENT_VIDEOS_PER_RUN=18
YOUTUBE_COMMENT_THREADS_PER_VIDEO=30
YOUTUBE_COMMENT_REPLIES_PER_THREAD=6
YOUTUBE_MAX_SNAPSHOTS_PER_VIDEO=96
YOUTUBE_QUOTA_BUDGET_PER_RUN=900
YOUTUBE_DISCOVERY_MAX_AGE_HOURS=168
REDDIT_CLIENT_ID=REPLACE_WITH_REDDIT_CLIENT_ID
REDDIT_CLIENT_SECRET=REPLACE_WITH_REDDIT_CLIENT_SECRET
REDDIT_USER_AGENT=sentiment-analysis-local-dev/0.1
